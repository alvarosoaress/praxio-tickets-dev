{
  "name": "tickets",
  "version": "1.3.2",
  "description": "Tickets abertos que precisam de acao do time de desenvolvimento",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node test.js"
  },
  "author": "",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.alvaro.tickets",
    "productName": "Tickets",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "sanitize.js",
      "services/**/*",
      "ipc/**/*",
      "style.css",
      "build/icon.ico",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ]
  },
  "dependencies": {
    "mammoth": "^1.12.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
